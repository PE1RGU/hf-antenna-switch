	(text "Purpose: measure RF isolation between adjacent signal groups on the DIN 41612 backplane path.\nVersion A (S1 to S2): one open contact between the groups.\nVersion B (S2 to S3): one GND contact between the groups.\nEach RF line uses two contacts in parallel. All other contacts are GND.\nMeasure S21 between SMA ports with the other ports terminated in 50 ohm.\nTest: NanoVNA-H4, 1 to 54 MHz. Target: isolation of 50 dB or better at 28.5 MHz."
		(exclude_from_sim no)
		(at 25.4 125.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f04be8ca-eca0-4289-8ef5-4bf957f97b8d")
	)
