# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# KiCad: backups, local state, caches
*-backups/
.history/
*.kicad_prl
*.lck
fp-info-cache
~*.lck

# Vendor datasheets: not ours to redistribute. The register stays.
Datasheets/*.pdf

# Working folders, not for publication
Claude outputs/
**/_to_delete/
test-pieces/

# Vendor libraries (SnapEDA, SamacSys, Ultra Librarian): terms do not clearly allow
# redistribution. See hardware/THIRD-PARTY.md for where to get them.
hardware/**/lib/snapeda-*/
hardware/**/lib/samacsys-*/
hardware/**/lib/ultralibrarian-*/
hardware/**/lib/3d/
**/*.3dshapes/

# KiCad generated output (regenerate with kicad-cli; the PDFs stay)
hardware/**/svg*/
hardware/**/_sym_export/
hardware/**/erc.json
hardware/**/lib/test-3d/
*.unused
*.bak-gen
**/_tmp/

# Netlist exports in the board folders (regenerable). The netlists in
# hardware/unit/verify/ are inputs of the verification scripts and stay.
hardware/shack-interface/*.xml
hardware/unit/controller-board/*.xml
hardware/unit/controller-board/_sym/*.xml
hardware/unit/controller-board/_sym/*.pdf

# Editor backups of CAD files
*.bak

# iCloud sync conflict copies ("name 2", "name 2.ext")
* 2
* 2.*

# Vendor 3D models and documents for the front panel parts (EAO, C&K, Waveshare): not ours to
# redistribute. See hardware/THIRD-PARTY.md for where to get them.
hardware/shack-interface/endplates/parts/
hardware/shack-interface/endplates/display/
hardware/shack-interface/endplates/display-candidates/*/

# Render inputs and SolidCraft designs: regenerable (world_parts.py, kicad-cli, render-full.json)
# and partly built from vendor models
hardware/shack-interface/case/render-full/*.step
hardware/shack-interface/case/render-full/*.solidcraft

# Superseded board STEP exports (the current one is ref-shack-interface-p8.step)
hardware/shack-interface/case/ref-shack-interface-p6.step
hardware/shack-interface/case/ref-shack-interface-p7.step
